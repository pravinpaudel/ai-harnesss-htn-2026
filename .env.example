# ---------------------------------------------------------------------------
# Shared (used by ingest, API, worker, and research engine)
# ---------------------------------------------------------------------------
OPENAI_API_KEY=
HARNESS_DATABASE_URL=postgresql+psycopg://harness:harness@localhost:5432/harness
HARNESS_OPENAI_MODEL=gpt-5.6-luna
HARNESS_OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# ---------------------------------------------------------------------------
# Ingest, API, and worker (Developer A)
# ---------------------------------------------------------------------------
HARNESS_RAW_STORAGE_PATH=.data/raw
HARNESS_PARSER_VERSION=0.1.0
HARNESS_JOB_MAX_ATTEMPTS=3
HARNESS_OPENAI_MAX_OUTPUT_TOKENS=1200
HARNESS_OPENAI_REASONING_EFFORT=medium
HARNESS_MCP_URL=http://3.143.20.160/mcp
HARNESS_MCP_FINANCIAL_DATA_TOOL=financialDataRetrieval

# ---------------------------------------------------------------------------
# Research engine (Developer B) — optional overrides
# The engine reuses OPENAI_API_KEY, HARNESS_DATABASE_URL, HARNESS_OPENAI_MODEL,
# and HARNESS_OPENAI_EMBEDDING_MODEL when the HTN_* vars below are unset.
# ---------------------------------------------------------------------------
# DATABASE_URL_ENGINE=postgresql+psycopg://htn_engine:htn_engine@localhost:5432/harness
# HTN_MODEL=
# HTN_EMBEDDING_MODEL=
HTN_MAX_TOOL_ROUNDS=6
HTN_MAX_TOKENS=60000
HTN_MAX_COST_USD=0.50
HTN_MAX_LATENCY_MS=60000
HTN_PROMPT_VERSION=answer_v1
# Per-model prices for cost metering, USD per million tokens:
# HTN_PRICES={"model-name": {"input_per_mtok": 0.0, "output_per_mtok": 0.0}}

# ---------------------------------------------------------------------------
# Test database (tests/engine/compose.test.yml)
# ---------------------------------------------------------------------------
HTN_TEST_ADMIN_URL=postgresql+psycopg://postgres:postgres@localhost:55432/htn_test
