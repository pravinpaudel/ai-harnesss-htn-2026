{
 "$defs": {
  "AnswerStatus": {
   "enum": [
    "answered",
    "conflict",
    "declined",
    "partial"
   ],
   "title": "AnswerStatus",
   "type": "string"
  },
  "AnswerValue": {
   "additionalProperties": false,
   "properties": {
    "citation_ids": {
     "items": {
      "type": "integer"
     },
     "minItems": 1,
     "title": "Citation Ids",
     "type": "array"
    },
    "currency": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Currency"
    },
    "label": {
     "title": "Label",
     "type": "string"
    },
    "period": {
     "anyOf": [
      {
       "$ref": "#/$defs/Period"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "unit": {
     "$ref": "#/$defs/Unit"
    },
    "value": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value"
    },
    "value_high": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value High"
    },
    "value_low": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value Low"
    },
    "value_text": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Value Text"
    }
   },
   "required": [
    "label",
    "unit",
    "citation_ids"
   ],
   "title": "AnswerValue",
   "type": "object"
  },
  "Basis": {
   "enum": [
    "gaap",
    "adjusted",
    "non_gaap"
   ],
   "title": "Basis",
   "type": "string"
  },
  "CalculationResult": {
   "additionalProperties": false,
   "properties": {
    "currency": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Currency"
    },
    "formula": {
     "title": "Formula",
     "type": "string"
    },
    "operands": {
     "items": {
      "$ref": "#/$defs/Operand"
     },
     "title": "Operands",
     "type": "array"
    },
    "operation": {
     "$ref": "#/$defs/Operation"
    },
    "rejected": {
     "default": false,
     "title": "Rejected",
     "type": "boolean"
    },
    "rejection_reason": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Rejection Reason"
    },
    "result": {
     "anyOf": [
      {
       "type": "number"
      },
      {
       "type": "null"
      }
     ],
     "title": "Result"
    },
    "result_items": {
     "items": {
      "type": "string"
     },
     "title": "Result Items",
     "type": "array"
    },
    "rounding": {
     "title": "Rounding",
     "type": "integer"
    },
    "unit": {
     "$ref": "#/$defs/Unit"
    }
   },
   "required": [
    "operation",
    "formula",
    "operands",
    "result",
    "unit",
    "rounding"
   ],
   "title": "CalculationResult",
   "type": "object"
  },
  "Citation": {
   "additionalProperties": false,
   "properties": {
    "citation_id": {
     "minimum": 1,
     "title": "Citation Id",
     "type": "integer"
    },
    "evidence_id": {
     "anyOf": [
      {
       "format": "uuid",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Evidence Id"
    },
    "evidence_kind": {
     "$ref": "#/$defs/EvidenceKind"
    },
    "span": {
     "$ref": "#/$defs/SourceSpan"
    },
    "verified": {
     "const": true,
     "title": "Verified",
     "type": "boolean"
    }
   },
   "required": [
    "citation_id",
    "span",
    "evidence_kind",
    "verified"
   ],
   "title": "Citation",
   "type": "object"
  },
  "ConflictClaim": {
   "additionalProperties": false,
   "properties": {
    "citation_ids": {
     "items": {
      "type": "integer"
     },
     "minItems": 1,
     "title": "Citation Ids",
     "type": "array"
    },
    "text": {
     "title": "Text",
     "type": "string"
    }
   },
   "required": [
    "text",
    "citation_ids"
   ],
   "title": "ConflictClaim",
   "type": "object"
  },
  "ConflictRef": {
   "additionalProperties": false,
   "properties": {
    "claims": {
     "items": {
      "$ref": "#/$defs/ConflictClaim"
     },
     "minItems": 2,
     "title": "Claims",
     "type": "array"
    },
    "explanation": {
     "title": "Explanation",
     "type": "string"
    },
    "finding_id": {
     "anyOf": [
      {
       "format": "uuid",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "title": "Finding Id"
    },
    "rule": {
     "$ref": "#/$defs/FindingRule"
    }
   },
   "required": [
    "finding_id",
    "rule",
    "explanation",
    "claims"
   ],
   "title": "ConflictRef",
   "type": "object"
  },
  "DeclineReason": {
   "enum": [
    "insufficient_evidence",
    "false_premise",
    "incompatible_currency",
    "ambiguous_period_or_basis",
    "out_of_corpus_entity",
    "future_data",
    "budget_exhausted"
   ],
   "title": "DeclineReason",
   "type": "string"
  },
  "EvidenceKind": {
   "enum": [
    "chunk",
    "table_cell",
    "fact"
   ],
   "title": "EvidenceKind",
   "type": "string"
  },
  "EvidenceStatus": {
   "enum": [
    "fully_supported",
    "conflicting",
    "partial_support",
    "unsupported"
   ],
   "title": "EvidenceStatus",
   "type": "string"
  },
  "FindingRule": {
   "enum": [
    "unit_currency_mix",
    "arithmetic",
    "rank_order",
    "count_claim",
    "trend_direction",
    "duplicate_claim",
    "period_order"
   ],
   "title": "FindingRule",
   "type": "string"
  },
  "Operand": {
   "additionalProperties": false,
   "properties": {
    "basis": {
     "anyOf": [
      {
       "$ref": "#/$defs/Basis"
      },
      {
       "type": "null"
      }
     ],
     "default": null
    },
    "currency": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Currency"
    },
    "fact_id": {
     "anyOf": [
      {
       "format": "uuid",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Fact Id"
    },
    "name": {
     "title": "Name",
     "type": "string"
    },
    "period": {
     "$ref": "#/$defs/Period"
    },
    "span": {
     "$ref": "#/$defs/SourceSpan"
    },
    "unit": {
     "$ref": "#/$defs/Unit"
    },
    "value": {
     "title": "Value",
     "type": "number"
    }
   },
   "required": [
    "name",
    "value",
    "unit",
    "period",
    "span"
   ],
   "title": "Operand",
   "type": "object"
  },
  "Operation": {
   "enum": [
    "difference",
    "percent_change",
    "ratio",
    "sum",
    "average",
    "median",
    "rank",
    "compare"
   ],
   "title": "Operation",
   "type": "string"
  },
  "Period": {
   "additionalProperties": false,
   "properties": {
    "end": {
     "anyOf": [
      {
       "format": "date",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "End"
    },
    "label": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Label"
    },
    "type": {
     "$ref": "#/$defs/PeriodType",
     "default": "unspecified"
    }
   },
   "title": "Period",
   "type": "object"
  },
  "PeriodType": {
   "enum": [
    "fiscal",
    "calendar",
    "trailing",
    "point",
    "range",
    "unspecified"
   ],
   "title": "PeriodType",
   "type": "string"
  },
  "Provenance": {
   "additionalProperties": false,
   "properties": {
    "contract_version": {
     "default": "1.2",
     "title": "Contract Version",
     "type": "string"
    },
    "dataset_id": {
     "format": "uuid",
     "title": "Dataset Id",
     "type": "string"
    },
    "embedding_model": {
     "anyOf": [
      {
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Embedding Model"
    },
    "model": {
     "title": "Model",
     "type": "string"
    },
    "parser_version": {
     "title": "Parser Version",
     "type": "string"
    },
    "prompt_version": {
     "title": "Prompt Version",
     "type": "string"
    },
    "source_hash": {
     "title": "Source Hash",
     "type": "string"
    },
    "usage": {
     "$ref": "#/$defs/Usage"
    }
   },
   "required": [
    "dataset_id",
    "source_hash",
    "parser_version",
    "prompt_version",
    "model",
    "usage"
   ],
   "title": "Provenance",
   "type": "object"
  },
  "SourceSpan": {
   "additionalProperties": false,
   "properties": {
    "char_end": {
     "minimum": 0,
     "title": "Char End",
     "type": "integer"
    },
    "char_start": {
     "minimum": 0,
     "title": "Char Start",
     "type": "integer"
    },
    "document_hash": {
     "pattern": "^[0-9a-f]{64}$",
     "title": "Document Hash",
     "type": "string"
    },
    "document_id": {
     "anyOf": [
      {
       "format": "uuid",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Document Id"
    },
    "document_name": {
     "title": "Document Name",
     "type": "string"
    },
    "exact_text": {
     "minLength": 1,
     "title": "Exact Text",
     "type": "string"
    },
    "heading_path": {
     "items": {
      "type": "string"
     },
     "title": "Heading Path",
     "type": "array"
    },
    "line_end": {
     "minimum": 1,
     "title": "Line End",
     "type": "integer"
    },
    "line_start": {
     "minimum": 1,
     "title": "Line Start",
     "type": "integer"
    },
    "span_id": {
     "anyOf": [
      {
       "format": "uuid",
       "type": "string"
      },
      {
       "type": "null"
      }
     ],
     "default": null,
     "title": "Span Id"
    }
   },
   "required": [
    "document_name",
    "document_hash",
    "line_start",
    "line_end",
    "char_start",
    "char_end",
    "exact_text"
   ],
   "title": "SourceSpan",
   "type": "object"
  },
  "Unit": {
   "enum": [
    "money",
    "pct",
    "bps",
    "x",
    "count",
    "rank",
    "quantity",
    "ratio",
    "score",
    "text",
    "unknown"
   ],
   "title": "Unit",
   "type": "string"
  },
  "Usage": {
   "additionalProperties": false,
   "properties": {
    "cost_usd": {
     "default": 0.0,
     "title": "Cost Usd",
     "type": "number"
    },
    "embedding_tokens": {
     "default": 0,
     "title": "Embedding Tokens",
     "type": "integer"
    },
    "input_tokens": {
     "default": 0,
     "title": "Input Tokens",
     "type": "integer"
    },
    "latency_ms": {
     "default": 0,
     "title": "Latency Ms",
     "type": "integer"
    },
    "output_tokens": {
     "default": 0,
     "title": "Output Tokens",
     "type": "integer"
    },
    "tool_rounds": {
     "default": 0,
     "title": "Tool Rounds",
     "type": "integer"
    }
   },
   "title": "Usage",
   "type": "object"
  }
 },
 "additionalProperties": false,
 "properties": {
  "answer": {
   "title": "Answer",
   "type": "string"
  },
  "calculation_trace": {
   "items": {
    "$ref": "#/$defs/CalculationResult"
   },
   "title": "Calculation Trace",
   "type": "array"
  },
  "citations": {
   "items": {
    "$ref": "#/$defs/Citation"
   },
   "title": "Citations",
   "type": "array"
  },
  "conflicts": {
   "items": {
    "$ref": "#/$defs/ConflictRef"
   },
   "title": "Conflicts",
   "type": "array"
  },
  "dataset_version": {
   "format": "uuid",
   "title": "Dataset Version",
   "type": "string"
  },
  "decline_reason": {
   "anyOf": [
    {
     "$ref": "#/$defs/DeclineReason"
    },
    {
     "type": "null"
    }
   ],
   "default": null
  },
  "evidence_status": {
   "$ref": "#/$defs/EvidenceStatus"
  },
  "limitations": {
   "items": {
    "type": "string"
   },
   "title": "Limitations",
   "type": "array"
  },
  "provenance": {
   "$ref": "#/$defs/Provenance"
  },
  "run_id": {
   "format": "uuid",
   "title": "Run Id",
   "type": "string"
  },
  "status": {
   "$ref": "#/$defs/AnswerStatus"
  },
  "values": {
   "items": {
    "$ref": "#/$defs/AnswerValue"
   },
   "title": "Values",
   "type": "array"
  }
 },
 "required": [
  "run_id",
  "status",
  "answer",
  "evidence_status",
  "dataset_version",
  "provenance"
 ],
 "title": "AnswerResponse",
 "type": "object"
}
