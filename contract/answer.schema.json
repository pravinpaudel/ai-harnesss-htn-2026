{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "htn/contract/answer.schema.json",
  "title": "Answer",
  "description": "Contract v1. What every `htn ask` returns; `--json` emits exactly this object. `htn batch` emits {\"answers\": [Answer, ...]}.",
  "type": "object",
  "additionalProperties": false,
  "required": ["run_id", "question", "status", "answer_text", "citations", "conflicts", "confidence", "cost", "provenance"],
  "properties": {
    "run_id": { "type": "string", "description": "Unique per run; key into runs.duckdb for `htn trace`." },
    "question": { "type": "string" },
    "status": {
      "enum": ["answered", "conflict", "declined", "partial"],
      "description": "answered: supported by verified citations. conflict: the corpus contradicts itself on the answer; both sides shown. declined: the corpus does not support an answer. partial: budget/step limit hit; answer_text says what is missing."
    },
    "answer_text": {
      "type": "string",
      "description": "Plain-language answer. Every factual claim carries a footnote marker [n] matching citations[].n. Empty string only when status=declined and decline_reason says why."
    },
    "value": {
      "description": "Typed answer for quantitative questions; omitted for narrative ones.",
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind"],
          "properties": {
            "kind": { "enum": ["scalar", "entity", "list", "ordered_list", "range"] },
            "num": { "type": ["number", "null"] },
            "text": { "type": ["string", "null"] },
            "low": { "type": ["number", "null"] },
            "high": { "type": ["number", "null"] },
            "items": { "type": "array", "items": { "type": "string" } },
            "unit": { "type": ["string", "null"] },
            "currency": { "enum": ["CAD", "USD", null] },
            "period_label": { "type": ["string", "null"] }
          }
        }
      ]
    },
    "citations": {
      "type": "array",
      "description": "Every quote has passed the quote-in-source check: it appears verbatim in raw/<filename> within [line_start, line_end]. Unverified citations are dropped before output.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["n", "doc_id", "filename", "section_id", "line_start", "line_end", "quote"],
        "properties": {
          "n": { "type": "integer", "minimum": 1 },
          "doc_id": { "type": "string" },
          "filename": { "type": "string" },
          "section_id": { "type": "string" },
          "section_heading": { "type": "string" },
          "line_start": { "type": "integer", "minimum": 1 },
          "line_end": { "type": "integer", "minimum": 1 },
          "quote": { "type": "string", "minLength": 1 },
          "fact_ids": { "type": "array", "items": { "type": "string" } },
          "chunk_id": { "type": ["string", "null"] }
        }
      }
    },
    "conflicts": {
      "type": "array",
      "description": "Non-empty when status=conflict; may also list conflicts that touch the answer without changing it.",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["conflict_id", "check_type", "description", "claim_a", "claim_b"],
        "properties": {
          "conflict_id": { "type": "string" },
          "check_type": { "enum": ["ordering", "count", "trend_direction", "cross_section", "unit_mix"] },
          "description": { "type": "string" },
          "claim_a": { "$ref": "#/$defs/claim" },
          "claim_b": { "$ref": "#/$defs/claim" }
        }
      }
    },
    "decline_reason": {
      "enum": ["not_in_corpus", "false_premise", "ambiguous", "cross_currency", "out_of_scope", null],
      "description": "Required when status=declined."
    },
    "decline_detail": { "type": ["string", "null"], "description": "One sentence: what was looked for and what the corpus says instead." },
    "confidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["level", "reason"],
      "properties": {
        "level": { "enum": ["high", "medium", "low"] },
        "reason": { "type": "string" }
      }
    },
    "cost": {
      "type": "object",
      "additionalProperties": false,
      "required": ["input_tokens", "output_tokens", "usd", "latency_ms", "tool_calls"],
      "properties": {
        "input_tokens": { "type": "integer", "minimum": 0 },
        "output_tokens": { "type": "integer", "minimum": 0 },
        "usd": { "type": "number", "minimum": 0 },
        "latency_ms": { "type": "integer", "minimum": 0 },
        "tool_calls": { "type": "integer", "minimum": 0 }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": false,
      "required": ["corpus_name", "corpus_sha256", "contract_version", "model", "prompt_version"],
      "properties": {
        "corpus_name": { "type": "string" },
        "corpus_sha256": { "type": "string", "description": "sha256 over the sorted per-document snapshot_sha256 values." },
        "contract_version": { "type": "string" },
        "model": { "type": "string" },
        "prompt_version": { "type": "string" }
      }
    }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "declined" } } },
      "then": { "required": ["decline_reason"], "properties": { "decline_reason": { "not": { "const": null } } } } },
    { "if": { "properties": { "status": { "const": "conflict" } } },
      "then": { "properties": { "conflicts": { "minItems": 1 } } } },
    { "if": { "properties": { "status": { "const": "answered" } } },
      "then": { "properties": { "citations": { "minItems": 1 } } } }
  ],
  "$defs": {
    "claim": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "citation_n"],
      "properties": {
        "text": { "type": "string", "description": "What this side of the conflict asserts, e.g. 'Payments penetration 58% → 68%'." },
        "citation_n": { "type": "integer", "minimum": 1, "description": "Index into citations[]." }
      }
    }
  }
}
